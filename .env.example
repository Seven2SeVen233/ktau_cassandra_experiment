# Template of the environment variables used for docker compose interpolation.
# At runtime the .env file at the project root is used (generated by
# scripts/prepare_env.py from config.yaml; it is already in .gitignore).
# This file is for documentation only; do not edit and commit it directly.
CASSANDRA_IMAGE=cassandra:4.1
CASSANDRA_CLUSTER_NAME=ktau
CASSANDRA_DC=dc1
CASSANDRA_RACK=rack1
CASSANDRA_CONTAINER_PREFIX=ktau-cass
CASSANDRA_CLIENT_PORT=9042
CASSANDRA_MAX_HEAP=1G
CASSANDRA_HEAP_NEWSIZE=256M
CASSANDRA_CPU_LIMIT=2.0
CASSANDRA_MEM_LIMIT=3G
