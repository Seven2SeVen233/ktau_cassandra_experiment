\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Fig. 1. Validation that $\tau $-optimal feasible merging is achievable, via its concrete instantiation—the lexicographic (infinite-weight) case of weighted Ranked Pairs (causal edges locked first)—against the causally constrained Kemeny-Young optimum at small conflict-group sizes (N = 10, 24 trials each, partial ballots, no dissemination). (a) Fraction of trials in which the instantiation achieves the exact constrained optimum. (b) Excess total $\tau $ distance above the constrained optimum. The instantiation is exact in 89\% of trials overall, with average excess 0.35\% (maximum 8.0\% in a single M = 5 trial); the constrained and unconstrained optima coincide in 100\% of these trials.}}{14}{figure.1}\protected@file@percent }
\newlabel{fig:1}{{1}{14}{Fig. 1. Validation that $\tau $-optimal feasible merging is achievable, via its concrete instantiation—the lexicographic (infinite-weight) case of weighted Ranked Pairs (causal edges locked first)—against the causally constrained Kemeny-Young optimum at small conflict-group sizes (N = 10, 24 trials each, partial ballots, no dissemination). (a) Fraction of trials in which the instantiation achieves the exact constrained optimum. (b) Excess total $\tau $ distance above the constrained optimum. The instantiation is exact in 89\% of trials overall, with average excess 0.35\% (maximum 8.0\% in a single M = 5 trial); the constrained and unconstrained optima coincide in 100\% of these trials}{figure.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.4}Experiment 2: End-to-End Comparison}{14}{subsection.6.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Fig. 2. Causal decomposition of total $\tau $ distance (Proposition 2) on partial ballots without dissemination. Red: $\tau _{\mathrm  {causal}}$ (causal-constraint violations). Blue: $\tau _{\mathrm  {contested}}$ (genuine ordering disagreement). Dark bars: low conflict (35\% causal density). Light bars: high conflict (10\% causal density). $\tau _{\mathrm  {causal}}$ is identically zero for CF-RP, vector clocks, and pure CRDT at both conflict levels—the constraint holds by construction—while timestamp-based LWW and CRDT+LWW incur 16.2 (high) to 55.3 (low) causal violations per trial on average, which the metric counts exactly; leader overwrite's timestamp-append fallback incurs 2.7–8.3.}}{15}{figure.2}\protected@file@percent }
\newlabel{fig:2}{{2}{15}{Fig. 2. Causal decomposition of total $\tau $ distance (Proposition 2) on partial ballots without dissemination. Red: $\tau _{\mathrm {causal}}$ (causal-constraint violations). Blue: $\tau _{\mathrm {contested}}$ (genuine ordering disagreement). Dark bars: low conflict (35\% causal density). Light bars: high conflict (10\% causal density). $\tau _{\mathrm {causal}}$ is identically zero for CF-RP, vector clocks, and pure CRDT at both conflict levels—the constraint holds by construction—while timestamp-based LWW and CRDT+LWW incur 16.2 (high) to 55.3 (low) causal violations per trial on average, which the metric counts exactly; leader overwrite's timestamp-append fallback incurs 2.7–8.3}{figure.2}{}}
