\@writefile{toc}{\contentsline {section}{\numberline {7}Validation on Real Traces}{21}{section.7}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {7.1}The Monitoring System and Scenarios}{21}{subsection.7.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {7.2}Monitor design. The monitoring system runs as a coordinator-side process that samples the per-replica logs at a fixed period (1 s in our deployment) and maintains a sliding window over the most recent operations of each replica. For each window it computes the merged $\hat  {\tau }$ of §5.1 with effective normalization—$Z_{\mathrm  {eff}}$ accounts for live windows that do not yet contain all operations, so the measure stays calibrated under partial observation—and compares it against two standard signals: the maximum replica lag (a binary, set-level indicator) and the operation-set Jaccard index (a similarity indicator). An alert fires when windowed $\hat  {\tau }$ crosses a threshold that no benign steady-state fluctuation reaches. The design is deliberately light: no coordination, no propagation, and no instrumentation beyond reading the logs; per-window cost is $O(M^{2}$ log M) in the window size, negligible at production sampling rates.}{21}{subsection.7.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {7.3}Results: Monitoring and Merge Validation}{21}{subsection.7.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Table 6. Fault-injection evaluation (E7) on the Cassandra cluster: detection latency and faulty-replica localization. —” = never detected; localization reports the fraction of fault-window samples in which the faulty replica ranks first (per-replica $\hat {\tau };$ Jaccard/repair = set-mismatch signal). Means over 3 trials.}}{22}{table.5}\protected@file@percent }
\newlabel{tbl:5}{{5}{22}{Table 6. Fault-injection evaluation (E7) on the Cassandra cluster: detection latency and faulty-replica localization. —” = never detected; localization reports the fraction of fault-window samples in which the faulty replica ranks first (per-replica $\protect \hat {\tau };$ Jaccard/repair = set-mismatch signal). Means over 3 trials}{table.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Fig. 7. Fault-injection monitoring on the Cassandra cluster (E7). (a) Byzantine reorder: $\hat {\tau }$ rises and the faulty replica's per-node $\hat {\tau }$ dominates while lag $\equiv $ 0 and Jaccard $\equiv $ 1.0. (b) Steady-state missing writes: $\hat {\tau }$ $\equiv $ 0 while Jaccard falls—set-level faults are invisible to $\tau $ and caught by the Jaccard/repair signals. Shaded region: fault window.}}{23}{figure.7}\protected@file@percent }
\newlabel{fig:7}{{7}{23}{Fig. 7. Fault-injection monitoring on the Cassandra cluster (E7). (a) Byzantine reorder: $\protect \hat {\tau }$ rises and the faulty replica's per-node $\protect \hat {\tau }$ dominates while lag $\equiv $ 0 and Jaccard $\equiv $ 1.0. (b) Steady-state missing writes: $\protect \hat {\tau }$ $\equiv $ 0 while Jaccard falls—set-level faults are invisible to $\tau $ and caught by the Jaccard/repair signals. Shaded region: fault window}{figure.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Table 5. Live monitoring (E4): detection of ordering drift invisible to binary lag and operation-set similarity.}}{23}{table.6}\protected@file@percent }
\newlabel{tbl:6}{{6}{23}{Table 5. Live monitoring (E4): detection of ordering drift invisible to binary lag and operation-set similarity}{table.6}{}}
